# ===== 视觉AI识图配置（选一家填写即可） =====
# 说明：识别战绩图时优先调用视觉大模型，比本地OCR更准。
# 未配置时自动回退到本地 RapidOCR 识别，不影响使用。

# ① 智谱AI（推荐，glm-4v-flash 免费）
# 获取Key: https://open.bigmodel.cn/ 注册 → API密钥
VISION_API_KEY=
VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
VISION_MODEL=glm-4v-flash

# ② 阿里百炼 qwen-vl-plus（有免费额度）
# 获取Key: https://bailian.console.aliyun.com/ → API-KEY
# VISION_API_KEY=
# VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VISION_MODEL=qwen-vl-plus

# ③ 硅基流动 Qwen2.5-VL-7B（有免费模型）
# 获取Key: https://cloud.siliconflow.cn/ → API密钥
# VISION_API_KEY=
# VISION_BASE_URL=https://api.siliconflow.cn/v1
# VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct

# ④ OpenAI
# VISION_API_KEY=
# VISION_BASE_URL=https://api.openai.com/v1
# VISION_MODEL=gpt-4o-mini

# ⑤ 火山豆包（使用接入点ID作为模型名）
# VISION_API_KEY=
# VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# VISION_MODEL=<接入点ID>

# ===== 其他 =====
# JWT 签名密钥（生产环境务必修改）
SECRET_KEY=mojin-race-dev-secret
